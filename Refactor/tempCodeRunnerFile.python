import os
import cv2
import numpy as np
import time

folder_path = r"C:/Users/win/Desktop/SunTrackerSplit/SunTracker-Refactor/Refactor/Images"
image_extensions = (".jpg", ".jpeg", ".png", ".bmp")

MARGIN = 20  # پیکسل اضافه در اطراف کادر تشخیص‌داده‌شده برای هاف

if not os.path.exists(folder_path):
    print(f"Error: Folder path does not exist -> {folder_path}")
else:
    for file_name in os.listdir(folder_path):
        if not file_name.lower().endswith(image_extensions):
            continue

        img_path = os.path.join(folder_path, file_name)
        image = cv2.imread(img_path)
        if image is None:
            continue

        # ۱. تغییر سایز
        resized_img = cv2.resize(image, (640, 480))

        # --- شروع اندازه‌گیری زمان پردازش ---
        start_time = time.perf_counter()

        # ۲. تبدیل به LAB و گرفتن کانال L
        lab_img = cv2.cvtColor(resized_img, cv2.COLOR_BGR2LAB)
        l_channel = lab_img[:, :, 0]

        # ۳. فیلتر گوسی
        blurred_l = cv2.GaussianBlur(l_channel, (7, 7), 0)

        # ۴. پیدا کردن بیشینه روشنایی (seed point برای فلادفیل)
        _, max_val, _, seed_point = cv2.minMaxLoc(blurred_l)

        # ۵. ساخت ماسک کمکی و اجرای سگمنتیشن با floodFill
        h, w = blurred_l.shape
        mask_temp = np.zeros((h + 2, w + 2), dtype=np.uint8)
        LO_DIFF = 5
        UP_DIFF = 0
        flags = 4 | (255 << 8) | cv2.FLOODFILL_MASK_ONLY | cv2.FLOODFILL_FIXED_RANGE

        cv2.floodFill(
            blurred_l.copy(),
            mask_temp,
            seed_point,
            0,
            LO_DIFF,
            UP_DIFF,
            flags,
        )
        sun_mask = mask_temp[1 : h + 1, 1 : w + 1]

        # ۶. پیدا کردن کانتور خروجی floodFill و کادر (bounding box) اطراف آن
        contours, _ = cv2.findContours(sun_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        circle_result = None
        window_box = None

        if contours:
            largest_contour = max(contours, key=cv2.contourArea)
            x, y, cw, ch = cv2.boundingRect(largest_contour)

            # کمی بزرگتر از خود کادر، طبق MARGIN، تا کمی جلوتر از لبه خورشید هم دیده شود
            x1 = max(0, x - MARGIN)
            y1 = max(0, y - MARGIN)
            x2 = min(w, x + cw + MARGIN)
            y2 = min(h, y + ch + MARGIN)
            window_box = (x1, y1, x2, y2)

            roi = blurred_l[y1:y2, x1:x2]

            # ۷. الگوریتم هاف روی همان پنجره برای تشخیص گردی
            circles = cv2.HoughCircles(
                roi,
                cv2.HOUGH_GRADIENT,
                dp=1.2,
                minDist=max(roi.shape[0], roi.shape[1]),
                param1=100,
                param2=30,
                minRadius=int(min(cw, ch) * 0.3),
                maxRadius=int(max(cw, ch) * 0.8),
            )

            if circles is not None:
                circles = np.round(circles[0, :]).astype(int)
                cx, cy, r = circles[0]  # قوی‌ترین دایره‌ای که هاف پیدا کرده
                # برگرداندن مختصات از فضای ROI به فضای تصویر اصلی
                circle_result = (cx + x1, cy + y1, r)

        # --- پایان اندازه‌گیری زمان پردازش ---
        end_time = time.perf_counter()

        execution_time_ms = (end_time - start_time) * 1000
        fps = 1000 / execution_time_ms if execution_time_ms > 0 else 0
        print(f"Image: {file_name} | Processing Time: {execution_time_ms:.2f} ms | FPS: {fps:.1f}")

        # ۸. مشخص کردن نقطه seed، کادر جستجو و دایره نهایی روی تصویر اصلی
        visual_img = resized_img.copy()
        cv2.circle(visual_img, seed_point, 5, (0, 0, 255), -1)

        if window_box:
            wx1, wy1, wx2, wy2 = window_box
            cv2.rectangle(visual_img, (wx1, wy1), (wx2, wy2), (255, 255, 0), 1)

        if circle_result:
            cx, cy, r = circle_result
            cv2.circle(visual_img, (cx, cy), r, (0, 255, 0), 2)
            cv2.circle(visual_img, (cx, cy), 2, (0, 255, 255), 3)

        time_text = f"Time: {execution_time_ms:.2f} ms ({fps:.1f} FPS)"
        cv2.putText(
            visual_img,
            time_text,
            (10, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (0, 255, 0),
            2,
        )

        # ۹. تبدیل ماسک به ۳ کاناله برای نمایش کنار هم
        mask_3channel = cv2.cvtColor(sun_mask, cv2.COLOR_GRAY2BGR)
        combined_view = np.hstack((visual_img, mask_3channel))

        # ۱۰. نمایش پنجره
        cv2.imshow("Original (Left) vs Segmented Mask (Right)", combined_view)
        key = cv2.waitKey(0)
        if key == 27:  # ESC
            break

    cv2.destroyAllWindows()